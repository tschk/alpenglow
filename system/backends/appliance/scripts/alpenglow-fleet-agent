#!/bin/sh
# Placeholder workstation fleet-agent interface. Do not vendor Fleet/osquery here.
set -eu

POLICY="/etc/alpenglow/fleet-agent.json"
if [ -x /usr/local/bin/alpenglow-fleet-agent.d/run ]; then
  exec /usr/local/bin/alpenglow-fleet-agent.d/run "$@"
fi
if [ -x /usr/local/libexec/alpenglow-fleet-agent ]; then
  exec /usr/local/libexec/alpenglow-fleet-agent "$@"
fi

printf 'alpenglow-fleet-agent: no agent installed (see %s)\n' "${POLICY}"
exit 0
