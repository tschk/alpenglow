# Cross compilers for the legacy kernels. Build once and reuse:
#   docker build --platform linux/amd64 -t alpenglow-cross -f scripts/Dockerfile.cross .
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq build-essential bc bison flex \
    libssl-dev libelf-dev \
    gcc-powerpc-linux-gnu binutils-powerpc-linux-gnu \
    gcc-arm-linux-gnueabi binutils-arm-linux-gnueabi \
    gcc-i686-linux-gnu binutils-i686-linux-gnu \
    ca-certificates && rm -rf /var/lib/apt/lists/*
