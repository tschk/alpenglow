#!/bin/sh
# Locked single-app session. Default app is /etc/alpenglow/kiosk-command.
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

KIOSK_COMMAND="/usr/bin/foot"
if [ -f /etc/alpenglow/kiosk-command ]; then
  KIOSK_COMMAND="$(sed -n '1p' /etc/alpenglow/kiosk-command)"
fi
if [ -z "${KIOSK_COMMAND}" ]; then
  KIOSK_COMMAND="/usr/bin/foot"
fi

if [ -x /usr/bin/sold ] || [ -x /usr/local/bin/sold ]; then
  if [ "${ALPENGLOW_SESSION:-}" = "sold" ] || [ "${SESSION:-}" = "sold" ]; then
    exec /usr/local/bin/sold-session-start
  fi
fi

if command -v cage >/dev/null 2>&1; then
  exec cage -d -- ${KIOSK_COMMAND}
fi

printf 'kiosk session: cage not installed\n' >&2
exit 1
