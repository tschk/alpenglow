{
  "schema_version": 1,
  "strategy": "atomic-generations",
  "status": "scaffold",
  "enabled": false,
  "rollback": true,
  "rollback_generations": 2,
  "generation_root": "/sysroot/alpenglow",
  "active_generation_link": "/sysroot/alpenglow/current",
