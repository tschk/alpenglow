# Alpenglow legacy: i486 kernel for QEMU pc. The shipped v86 kernel is built
# for an i686 and refuses to boot on a 486 or a Pentium.
CONFIG_M486=y
CONFIG_X86_MINIMUM_CPU_FAMILY=4
CONFIG_HIGHMEM=n
CONFIG_SMP=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_FB=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_PRINTK_TIME=n
