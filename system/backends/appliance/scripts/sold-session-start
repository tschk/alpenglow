#!/bin/sh
# Staging wrapper for Soliloquy sold. sold is not built in this tree.
set -eu

for candidate in /usr/local/bin/sold /usr/bin/sold; do
  if [ -x "${candidate}" ]; then
    exec "${candidate}" "$@"
  fi
done

printf 'sold is not installed. Stage the binary from https://github.com/tschk/soliloquy\n' >&2
exit 0
