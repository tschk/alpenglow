{
  "id": "alpenglow-native",
  "status": "active",
  "base": "alpenglow",
  "libc": "musl",
  "init": "dinit",
  "package_manager": "oil",
  "bootstrap_package_manager": "oil",
  "installer": "oil",
  "composition_model": "oasis-static",
  "boot_model": "diskless",
  "hardened": true,
  "profiles": {
    "minimal": {
      "packages": "packages-minimal.txt"
    },
    "standard": {
      "packages": "packages-standard.txt"
    },
    "desktop": {
      "packages": "packages-runtime.txt",
      "note": "BUILD_PROFILE=desktop defaults to ALPENGLOW_DESKTOP_FULL=1 (runtime world). The desktop edition uses packages-desktop-lite.txt."
    }
  },
  "editions": {
    "fast": { "packages": "packages-minimal.txt", "role": "appliance", "session": "none", "artifact": "image" },
    "minimal": { "packages": "packages-minimal.txt", "role": "appliance", "session": "none", "artifact": "image" },
    "standard": { "packages": "packages-standard.txt", "role": "appliance", "session": "none", "artifact": "image" },
    "desktop": { "packages": "packages-desktop-lite.txt", "role": "desktop", "session": "alpenglowed", "artifact": "image" },
    "desktop-full": { "packages": "packages-runtime.txt", "role": "desktop", "session": "alpenglowed", "artifact": "image" },
    "embedded": { "packages": "packages-embedded.txt", "role": "embedded", "session": "none", "artifact": "image" },
    "potatoes": { "packages": "packages-potatoes.txt", "role": "potatoes", "session": "none", "artifact": "image" },
    "containers": { "packages": "packages-containers.txt", "role": "containers", "session": "none", "artifact": "userspace" },
    "internet": { "packages": "packages-internet.txt", "role": "internet", "session": "sold", "artifact": "image" },
    "kiosk": { "packages": "packages-kiosk.txt", "role": "kiosk", "session": "cage", "artifact": "image" },
    "workstation": { "packages": "packages-runtime.txt", "role": "workstation", "session": "alpenglowed", "artifact": "image" }
  },
  "sessions": ["none", "alpenglowed", "sold", "cage"],
  "paths": {
    "packages": "packages-runtime.txt",
    "packages_dev": "packages-dev.txt",
    "services": "dinit",
    "configure_rootfs": "scripts/configure-rootfs.sh",
    "build_rootfs": "scripts/build-rootfs.sh",
    "installer": "../../appliance/scripts/oil-installer.sh"
  }
}
