#!/bin/sh
# ──────────────────────────────────────────────────────────────────────
# Alpenglow init — diskless immutable root
# ──────────────────────────────────────────────────────────────────────
set -eu

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

mkdir -p /dev/shm /run /tmp /sysroot /mnt
chmod 01777 /dev/shm /tmp

SHM_SIZE="mode=1777,size=256m"
if [ -r /proc/meminfo ]; then
  mem_total_kb=""
  while read -r key value _; do
    [ "$key" = "MemTotal:" ] && { mem_total_kb="$value"; break; }
  done < /proc/meminfo
  if [ -n "$mem_total_kb" ]; then
    SHM_SIZE="mode=1777,size=$((mem_total_kb / 2))k"
  fi
fi
mount -t tmpfs -o "$SHM_SIZE" tmpfs /dev/shm
mount -t tmpfs -o mode=1777 tmpfs /tmp
mkdir -p /run/user/0 /tmp /mnt/root

# Parse kernel cmdline
ALPENGLOW_IMAGE=""
ALPENGLOW_STATE=""
ALPENGLOW_STATE_ENCRYPTED=""
ALPENGLOW_STATE_KEY=""
ALPENGLOW_DEBUG=""

for arg in $(cat /proc/cmdline); do
  case "${arg}" in
    alpenglow.image=*)  ALPENGLOW_IMAGE="${arg#alpenglow.image=}" ;;
    alpenglow.state=*)  ALPENGLOW_STATE="${arg#alpenglow.state=}" ;;
    alpenglow.state.encrypted=*) ALPENGLOW_STATE_ENCRYPTED="${arg#alpenglow.state.encrypted=}" ;;
    alpenglow.state.key=*) ALPENGLOW_STATE_KEY="${arg#alpenglow.state.key=}" ;;
    alpenglow.debug)    ALPENGLOW_DEBUG="1" ;;
  esac
done

[ -n "${ALPENGLOW_DEBUG}" ] && set -x

valid_image_path() {
  case "$1" in
    LABEL=*|/sysroot/*|/mnt/*) return 0 ;;
    *) return 1 ;;
  esac
}

valid_state_path() {
  case "$1" in
    LABEL=alpenglow-state|/dev/*) return 0 ;;
    *) return 1 ;;
  esac
}

valid_key_path() {
  case "$1" in
    *..*) return 1 ;;
    /*) return 0 ;;
    *) return 1 ;;
  esac
}

rescue_or_halt() {
  msg="$1"
  echo "${msg}" >&2
  if [ -n "${ALPENGLOW_DEBUG}" ]; then
    exec /bin/sh
  fi
  echo "Halting (add alpenglow.debug to kernel cmdline for rescue shell)" >&2
  exec /sbin/poweroff -f
}

if [ -n "${ALPENGLOW_IMAGE}" ] && ! valid_image_path "${ALPENGLOW_IMAGE}"; then
  rescue_or_halt "Alpenglow: rejected alpenglow.image=${ALPENGLOW_IMAGE}"
fi
if [ -n "${ALPENGLOW_STATE}" ] && ! valid_state_path "${ALPENGLOW_STATE}"; then
  rescue_or_halt "Alpenglow: rejected alpenglow.state=${ALPENGLOW_STATE}"
fi
if [ -n "${ALPENGLOW_STATE_KEY}" ] && ! valid_key_path "${ALPENGLOW_STATE_KEY}"; then
  rescue_or_halt "Alpenglow: rejected alpenglow.state.key=${ALPENGLOW_STATE_KEY}"
fi

for m in erofs squashfs bcachefs dm-crypt virtio-blk virtio-net \
         snd snd-pcm cfg80211 mac80211 iwlwifi ath9k \
         hid usbhid i2c-dev acpi-cpufreq; do
  (modprobe "$m" 2>/dev/null || true) &
done
wait

# find_image: leave the hosting filesystem mounted at /mnt so the image
# path stays valid for a direct erofs/squashfs mount (no copy to /sysroot).
find_image() {
  if [ -n "${ALPENGLOW_IMAGE}" ] && [ -f "${ALPENGLOW_IMAGE}" ]; then
    echo "${ALPENGLOW_IMAGE}"; return
  fi
  for ext in erofs squashfs; do
    img="/sysroot/alpenglow/current.${ext}"
    [ -f "${img}" ] && echo "${img}" && return
  done
  local found
  found=$(blkid -L alpenglow-boot 2>/dev/null || true)
  if [ -n "${found}" ]; then
    if mount -r "${found}" /mnt 2>/dev/null; then
      for ext in erofs squashfs; do
        img="/mnt/alpenglow/current.${ext}"
        if [ -f "${img}" ]; then
          echo "${img}"
          return
        fi
      done
      umount /mnt 2>/dev/null || true
    fi
  fi
  for dev in /dev/vda* /dev/sda* /dev/nvme0n1* /dev/mmcblk0*; do
    [ -b "${dev}" ] || continue
    if mount -r "${dev}" /mnt 2>/dev/null; then
      for ext in erofs squashfs; do
        img="/mnt/alpenglow/current.${ext}"
        if [ -f "${img}" ]; then
          echo "${img}"
          return
        fi
      done
      umount /mnt 2>/dev/null || true
    fi
  done
  echo ""
}

state_block_dev() {
  spec="$1"
  case "${spec}" in
    LABEL=*) blkid -L "${spec#LABEL=}" 2>/dev/null || true ;;
    /dev/*) echo "${spec}" ;;
    *) echo "${spec}" ;;
  esac
}

state_is_luks() {
  dev="$1"
  [ -n "${dev}" ] && [ "$(blkid -o value -s TYPE "${dev}" 2>/dev/null)" = "crypto_LUKS" ]
}

open_luks_state() {
  spec="$1"
  dev="$(state_block_dev "${spec}")"
  if [ -z "${dev}" ]; then
    echo "state device not found: ${spec}" >&2
    return 1
  fi

  if [ -e /dev/mapper/alpenglow-state ]; then
    echo /dev/mapper/alpenglow-state
    return 0
  fi

  need_open=0
  if [ "${ALPENGLOW_STATE_ENCRYPTED}" = "1" ]; then
    need_open=1
  elif state_is_luks "${dev}"; then
    need_open=1
  fi

  if [ "${need_open}" -eq 0 ]; then
    echo "${spec}"
    return 0
  fi

  if ! state_is_luks "${dev}"; then
    echo "alpenglow.state.encrypted=1 but device is not LUKS: ${dev}" >&2
    return 1
  fi

  if ! command -v cryptsetup >/dev/null 2>&1; then
    echo "LUKS state device requires cryptsetup" >&2
    return 1
  fi

  if [ -n "${ALPENGLOW_STATE_KEY}" ] && [ -r "${ALPENGLOW_STATE_KEY}" ]; then
    cryptsetup luksOpen "${dev}" alpenglow-state --key-file "${ALPENGLOW_STATE_KEY}" || return 1
  else
    cryptsetup luksOpen "${dev}" alpenglow-state || return 1
  fi
  echo /dev/mapper/alpenglow-state
}

ROOT_IMAGE=$(find_image)
if [ -z "${ROOT_IMAGE}" ]; then
  rescue_or_halt "Alpenglow: no immutable root image found"
fi

echo "Alpenglow: mounting ${ROOT_IMAGE}..."
case "${ROOT_IMAGE}" in
  *.erofs)     mount -t erofs -o ro,nodev "${ROOT_IMAGE}" /mnt/root ;;
  *.squashfs)  mount -t squashfs -o ro,nodev "${ROOT_IMAGE}" /mnt/root ;;
  *) rescue_or_halt "Alpenglow: unsupported root image type: ${ROOT_IMAGE}" ;;
esac

if [ -n "${ALPENGLOW_STATE}" ]; then
  state_spec="${ALPENGLOW_STATE}"
else
  state_spec="LABEL=alpenglow-state"
fi
state_dev="$(open_luks_state "${state_spec}")" || rescue_or_halt "Alpenglow: LUKS state open failed: ${state_spec}"
mount -t bcachefs -o rw,nosuid,nodev "${state_dev}" /mnt/root/state 2>/dev/null || \
  rescue_or_halt "Alpenglow: bcachefs state mount failed: ${state_dev}"

exec switch_root /mnt/root /sbin/init
