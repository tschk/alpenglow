# Alpenglow legacy: 32-bit PowerPC for QEMU g3beige (Heathrow PowerMac).
# Serial console only. No modules, no graphics, no network.
# PPC32 is derived from !PPC64, so the switch has to disable PPC64.
CONFIG_PPC64=n
CONFIG_PPC_BOOK3S_32=y
CONFIG_PPC_PMAC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SERIAL_PMACZILOG=y
CONFIG_SERIAL_PMACZILOG_CONSOLE=y
CONFIG_BOOTX_TEXT=y
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_FB=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_PRINTK_TIME=n
